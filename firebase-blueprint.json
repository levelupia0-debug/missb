{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Publicly non-sensitive user profile metadata and role identifier.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the client or salon owner.",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Role of the user within the salon platform.",
          "enum": ["customer", "owner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "name", "role", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII document containing email, phone, and hair texture preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Client phone number.",
          "minLength": 0,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "description": "Hair texture and consultation notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "preferredStylist": {
          "type": "string",
          "description": "Preferred master stylist name.",
          "minLength": 0,
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "phone", "notes", "preferredStylist", "updatedAt"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Salon service catalog entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "longDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "price": {
          "type": "number",
          "description": "Service price in USD."
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration in minutes."
        },
        "category": {
          "type": "string",
          "enum": ["Cut & Styling", "Braids & Protective", "Color & Extensions", "Rituals & Bridal"]
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "active": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "tagline",
        "description",
        "longDescription",
        "price",
        "duration",
        "durationMinutes",
        "category",
        "imageUrl",
        "active",
        "updatedAt"
      ]
    },
    "BookingRecord": {
      "title": "BookingRecord",
      "description": "Appointment reservation made by a verified client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "customerPhone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "serviceCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "price": {
          "type": "number"
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "rescheduled", "cancelled", "completed"]
        },
        "emailStatus": {
          "type": "string",
          "enum": ["sent", "queued", "failed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "referenceCode",
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "serviceId",
        "serviceSlug",
        "serviceName",
        "serviceCategory",
        "price",
        "duration",
        "durationMinutes",
        "date",
        "time",
        "notes",
        "status",
        "emailStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "AvailabilityDay": {
      "title": "AvailabilityDay",
      "description": "Weekly operating schedule for a specific day of week.",
      "type": "object",
      "properties": {
        "dayOfWeek": {
          "type": "number"
        },
        "dayName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20
        },
        "isOpen": {
          "type": "boolean"
        },
        "openTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "closeTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["dayOfWeek", "dayName", "isOpen", "openTime", "closeTime", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted salon owner/admin privilege marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "User profile document storing non-PII identity and role."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII subcollection storing email, phone, and hair consultation notes."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Publicly readable salon service catalog managed exclusively by admins."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRecord" },
      "description": "Client appointment bookings isolated to the owning client or salon admin."
    },
    "/availability/{dayId}": {
      "schema": { "$ref": "#/entities/AvailabilityDay" },
      "description": "Weekly salon operating hours readable by clients and managed by admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin lookup collection for RBAC enforcement."
    }
  }
}
